{
  "name": "fs-solucoes-tributarias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "build:ui": "esbuild components/diagnostic-showcase.tsx --bundle --platform=node --format=esm --packages=external --outfile=.generated/diagnostic-showcase.mjs && tailwindcss -i styles/ui.css -o public/ui.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
